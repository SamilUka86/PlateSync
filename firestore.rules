rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY & AUTHENTICATION HELPER FUNCTIONS
    // =========================================================================

    // Verify user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify requesting user matches the document or path owner UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify requesting user is an authorized platform administrator
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'platesync86@gmail.com' ||
        request.auth.token.email == 'samilplatesync@gmail.com' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Verify requesting user is the super-admin platform owner
    function isPlatformOwner() {
      return isAuthenticated() && (
        request.auth.token.owner == true ||
        request.auth.token.email == 'platesync86@gmail.com' ||
        request.auth.token.email == 'samilplatesync@gmail.com' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Valid barbell / plate / display unit check ('KG', 'LB', or 'LBS')
    function isValidUnit(unit) {
      return unit == 'KG' || unit == 'LB' || unit == 'LBS';
    }

    // Positive numerical check (supports integers and floating-point numbers)
    function isPositiveNumber(val) {
      return val is number && val >= 0;
    }

    // Strictly positive numerical check (for physical attributes like height/bodyweight)
    function isStrictlyPositiveNumber(val) {
      return val is number && val > 0;
    }

    // String validation with max length
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // =========================================================================
    // 1. ATHLETE USER PROFILES: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      // Authenticated athlete can read their own profile; authorized admins can read for user management & live telemetry
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isPlatformOwner();

      // Create athlete profile: enforce UID match and validate data fields
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 100))
        && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 100))
        && (!('email' in request.resource.data) || isValidString(request.resource.data.email, 150))
        && (!('profileImage' in request.resource.data) || request.resource.data.profileImage == null || request.resource.data.profileImage is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && (!('height' in request.resource.data) || (isStrictlyPositiveNumber(request.resource.data.height) && request.resource.data.height <= 300))
        && (!('bodyWeight' in request.resource.data) || (isStrictlyPositiveNumber(request.resource.data.bodyWeight) && request.resource.data.bodyWeight <= 600))
        && (!('preferredUnit' in request.resource.data) || isValidUnit(request.resource.data.preferredUnit))
        && (!('defaultBarbellWeight' in request.resource.data) || (isPositiveNumber(request.resource.data.defaultBarbellWeight) && request.resource.data.defaultBarbellWeight <= 200))
        && (!('defaultBarbellUnit' in request.resource.data) || isValidUnit(request.resource.data.defaultBarbellUnit))
        && (!('theme' in request.resource.data) || isValidString(request.resource.data.theme, 50))
        && (!('bio' in request.resource.data) || isValidString(request.resource.data.bio, 500));

      // Update athlete profile: user can update own profile, admins can manage account status
      allow update: if isOwner(userId) || isAdmin();

      // =======================================================================
      // 1.1 WORKOUT SESSIONS: /users/{userId}/workouts/{workoutId}
      // =======================================================================
      match /workouts/{workoutId} {
        allow read: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();

        allow create, update: if (isOwner(userId) || isAdmin())
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
          && (!('workoutName' in request.resource.data) || isValidString(request.resource.data.workoutName, 150))
          && (!('title' in request.resource.data) || isValidString(request.resource.data.title, 150))
          && (!('duration' in request.resource.data) || isPositiveNumber(request.resource.data.duration))
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list)
          && (!('totalVolume' in request.resource.data) || isPositiveNumber(request.resource.data.totalVolume))
          && (!('totalVolumeKg' in request.resource.data) || isPositiveNumber(request.resource.data.totalVolumeKg))
          && (!('totalVolumeLbs' in request.resource.data) || isPositiveNumber(request.resource.data.totalVolumeLbs))
          && (!('totalSets' in request.resource.data) || isPositiveNumber(request.resource.data.totalSets))
          && (!('totalReps' in request.resource.data) || isPositiveNumber(request.resource.data.totalReps));
      }

      // =======================================================================
      // 1.2 SAVED PLATE & BARBELL SETUPS: /users/{userId}/plateConfigurations/{configId}
      // =======================================================================
      match /plateConfigurations/{configId} {
        allow read, delete: if isOwner(userId) || isAdmin();

        allow create, update: if (isOwner(userId) || isAdmin())
          && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 100))
          && (!('barbellWeight' in request.resource.data) || (isPositiveNumber(request.resource.data.barbellWeight) && request.resource.data.barbellWeight <= 200))
          && (!('barbellUnit' in request.resource.data) || isValidUnit(request.resource.data.barbellUnit))
          && (!('leftPlates' in request.resource.data) || request.resource.data.leftPlates is list)
          && (!('rightPlates' in request.resource.data) || request.resource.data.rightPlates is list)
          && (!('totalKg' in request.resource.data) || isPositiveNumber(request.resource.data.totalKg))
          && (!('totalLbs' in request.resource.data) || isPositiveNumber(request.resource.data.totalLbs));
      }

      // =======================================================================
      // 1.3 PERSONAL RECORDS (PRs): /users/{userId}/personalRecords/{recordId}
      // =======================================================================
      match /personalRecords/{recordId} {
        allow read, delete: if isOwner(userId) || isAdmin();

        allow create, update: if (isOwner(userId) || isAdmin())
          && (!('exerciseName' in request.resource.data) || isValidString(request.resource.data.exerciseName, 100))
          && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 100))
          && (!('maxWeightKg' in request.resource.data) || isPositiveNumber(request.resource.data.maxWeightKg))
          && (!('maxWeightLbs' in request.resource.data) || isPositiveNumber(request.resource.data.maxWeightLbs))
          && (!('reps' in request.resource.data) || isPositiveNumber(request.resource.data.reps));
      }

      // =======================================================================
      // 1.4 WORKOUT ROUTINE TEMPLATES: /users/{userId}/templates/{templateId}
      // =======================================================================
      match /templates/{templateId} {
        allow read, delete: if isOwner(userId) || isAdmin();

        allow create, update: if (isOwner(userId) || isAdmin())
          && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 100))
          && (!('title' in request.resource.data) || isValidString(request.resource.data.title, 100))
          && (!('split' in request.resource.data) || isValidString(request.resource.data.split, 50))
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list);
      }

      // =======================================================================
      // 1.5 CUSTOM ATHLETE EXERCISES: /users/{userId}/customExercises/{exerciseId}
      // =======================================================================
      match /customExercises/{exerciseId} {
        allow read, delete: if isOwner(userId) || isAdmin();

        allow create, update: if (isOwner(userId) || isAdmin())
          && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 100))
          && (!('muscle' in request.resource.data) || isValidString(request.resource.data.muscle, 50))
          && (!('category' in request.resource.data) || isValidString(request.resource.data.category, 50))
          && (!('equipment' in request.resource.data) || isValidString(request.resource.data.equipment, 50));
      }

      // =======================================================================
      // 1.6 BODY WEIGHT LOGS: /users/{userId}/weight_logs/{logId}
      // =======================================================================
      match /weight_logs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // =======================================================================
      // 1.7 WEEKLY PLANNER: /users/{userId}/planner/{planId}
      // =======================================================================
      match /planner/{planId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // =======================================================================
      // 1.8 USER FEEDBACK COPIES: /users/{userId}/feedback/{feedbackId}
      // =======================================================================
      match /feedback/{feedbackId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 2. ATHLETE FEEDBACK & BUG REPORTS: /userFeedback/{feedbackId}
    // =========================================================================
    match /userFeedback/{feedbackId} {
      // Any athlete, guest, or user can submit feedback; admins and creators can read & manage
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. LIVE USER PRESENCE: /userPresence/{userId}
    // =========================================================================
    match /userPresence/{userId} {
      // User can update their own presence heartbeats; Admins can read all presence
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 4. USER SESSIONS: /userSessions/{sessionId}
    // =========================================================================
    match /userSessions/{sessionId} {
      // Athletes create and update their session records; Admins can read and audit all sessions
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. REAL-TIME USER ACTIVITY EVENTS: /userActivityEvents/{eventId}
    // =========================================================================
    match /userActivityEvents/{eventId} {
      // Athletes append qualifying interaction events; Admins read all live events
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. DAILY USER ACTIVITY AGGREGATES: /dailyUserActivity/{date}
    // =========================================================================
    match /dailyUserActivity/{date} {
      allow read: if isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }

    // =========================================================================
    // 7. PLATFORM APPLICATION SETTINGS: /adminSettings/{settingId}
    // =========================================================================
    match /adminSettings/{settingId} {
      // Publicly readable for global maintenance mode check and broadcast banner announcements
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. ADMIN USER DIRECTORY & PRIVILEGES: /adminUsers/{adminId}
    // =========================================================================
    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if isPlatformOwner() || (
        isAuthenticated() && (
          request.auth.token.email == 'platesync86@gmail.com' ||
          request.auth.token.email == 'samilplatesync@gmail.com'
        )
      );
    }

    // =========================================================================
    // 9. ADMIN SECURITY AUDIT LOGS: /adminAuditLogs/{logId}
    // =========================================================================
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // 10. GLOBAL EXERCISE DATABASE: /exercises/{exerciseId}
    // =========================================================================
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. GLOBAL PREBUILT WORKOUT PROGRAMS: /workoutPrograms/{programId}
    // =========================================================================
    match /workoutPrograms/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT STRICT SECURITY RULE: DENY ALL UNMATCHED PATHS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}