rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY & AUTHENTICATION HELPER FUNCTIONS
    // =========================================================================

    // Verify user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify requesting user matches the document or path owner UID
    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify requesting user has admin privileges (via token custom claims or adminUsers collection)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Verify requesting user is the super-admin platform owner
    function isPlatformOwner() {
      return isAuthenticated() && (
        request.auth.token.owner == true ||
        ((request.auth.token.email == 'platesync86@gmail.com' || request.auth.token.email == 'samilplatesync@gmail.com') &&
         exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)))
      );
    }

    // Valid barbell / plate / display unit check ('KG', 'LB', or 'LBS')
    function isValidUnit(unit) {
      return unit == 'KG' || unit == 'LB' || unit == 'LBS';
    }

    // Positive numerical check (supports integers and floating-point numbers)
    function isPositiveNumber(val) {
      return val is number && val >= 0;
    }

    // Strictly positive numerical check (for physical attributes like height/bodyweight)
    function isStrictlyPositiveNumber(val) {
      return val is number && val > 0;
    }

    // String validation with max length
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // =========================================================================
    // 1. ATHLETE USER PROFILES & SUBCOLLECTIONS: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      // Authenticated athlete can read their own profile; authorized admins can read for user management
      allow read: if isDocOwner(userId) || isAdmin();
      allow delete: if isDocOwner(userId) || isPlatformOwner();

      // Create athlete profile
      allow create: if isDocOwner(userId)
        && request.resource.data.uid == userId
        && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 100))
        && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 100))
        && (!('email' in request.resource.data) || isValidString(request.resource.data.email, 150))
        && (!('height' in request.resource.data) || (isStrictlyPositiveNumber(request.resource.data.height) && request.resource.data.height <= 300))
        && (!('bodyWeight' in request.resource.data) || (isStrictlyPositiveNumber(request.resource.data.bodyWeight) && request.resource.data.bodyWeight <= 600))
        && (!('preferredUnit' in request.resource.data) || isValidUnit(request.resource.data.preferredUnit));

      // Update athlete profile: user can update own profile, admins can update account status
      allow update: if (isDocOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
        || isAdmin();

      // 1.1 Workout Sessions
      match /workouts/{workoutId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      // 1.2 Saved Plate & Barbell Setups
      match /plateConfigurations/{configId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      // 1.3 Personal Records (PRs)
      match /personalRecords/{recordId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      // 1.4 Workout Routine Templates
      match /templates/{templateId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      // 1.5 Custom Athlete Exercises
      match /customExercises/{exerciseId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      // 1.6 Body Weight Logs
      match /weight_logs/{logId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      // 1.7 Weekly Planner
      match /planner/{planId} {
        allow read: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 2. ADMIN ACCOUNTS & PERMISSIONS: /adminUsers/{adminId}
    // =========================================================================
    match /adminUsers/{adminId} {
      // Admins can read admin records
      allow read: if isAdmin();
      
      // Only the platform owner can create, update, or remove admin privileges
      allow create, update, delete: if isPlatformOwner() || (
        // Allow initial bootstrap if owner account authenticates
        isAuthenticated() && (request.auth.token.email == 'platesync86@gmail.com' || request.auth.token.email == 'samilplatesync@gmail.com')
      );
    }

    // =========================================================================
    // 3. GLOBAL EXERCISE DATABASE: /exercises/{exerciseId}
    // =========================================================================
    match /exercises/{exerciseId} {
      // Publicly readable by all athletes
      allow read: if true;
      // Only authorized administrators can add, edit, or delete exercises
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 4. PREBUILT & COMMUNITY WORKOUT PROGRAMS: /workoutPrograms/{programId}
    // =========================================================================
    match /workoutPrograms/{programId} {
      // Athletes can read published programs; admins can read all
      allow read: if resource.data.published == true || isAdmin();
      // Only admins can create, update, or delete programs
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. USER FEEDBACK & REPORTS: /userFeedback/{feedbackId}
    // =========================================================================
    match /userFeedback/{feedbackId} {
      // Athletes can create feedback stamped with their own UID
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Athletes can read their own feedback, Admins can read all feedback
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      // Only Admins can update status, add internal notes, or resolve feedback
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. PLATFORM APPLICATION SETTINGS: /adminSettings/{settingId}
    // =========================================================================
    match /adminSettings/{settingId} {
      // Publicly readable for global settings (announcement banners, maintenance status)
      allow read: if true;
      // Only admins can modify platform configuration
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. IMMUTABLE ADMIN AUDIT LOGS: /adminAuditLogs/{logId}
    // =========================================================================
    match /adminAuditLogs/{logId} {
      // Admins can read audit logs
      allow read: if isAdmin();
      // Admins can append audit logs
      allow create: if isAdmin();
      // Modifying or deleting audit logs is strictly blocked
      allow update, delete: if false;
    }

    // =========================================================================
    // 8. LIVE USER PRESENCE: /userPresence/{userId}
    // =========================================================================
    match /userPresence/{userId} {
      // Athlete can read own presence, Admins can read all presence
      allow read: if isDocOwner(userId) || isAdmin();
      // Athlete can update own presence (heartbeats, current session, status)
      allow write: if isDocOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 9. USER SESSIONS: /userSessions/{sessionId}
    // =========================================================================
    match /userSessions/{sessionId} {
      // Athletes can read their own sessions, Admins can inspect any user session
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      // Athletes can create their session records
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Athletes can update their active session heartbeats/duration; Admins can manage
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 10. REAL-TIME USER ACTIVITY EVENTS: /userActivityEvents/{eventId}
    // =========================================================================
    match /userActivityEvents/{eventId} {
      // Admins read all live events; Athletes can read their own events
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      // Athletes append qualifying interaction events with their own UID
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Activity events are immutable audit trails
      allow update, delete: if false;
    }

    // =========================================================================
    // 11. DAILY USER ACTIVITY AGGREGATES: /dailyUserActivity/{date}
    // =========================================================================
    match /dailyUserActivity/{date} {
      // Admins can read aggregate DAU reports
      allow read: if isAdmin();
      // Authenticated users and admins can record daily activity telemetry
      allow write: if isAuthenticated() || isAdmin();
    }

    // =========================================================================
    // DEFAULT STRICT SECURITY RULE: DENY ALL UNMATCHED PATHS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
